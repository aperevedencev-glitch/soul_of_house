# Soul of Home — настройки для хостинга reg.ru (Apache)
AddDefaultCharset UTF-8
Options -Indexes
DirectoryIndex index.html

# ---- HTTPS и адрес без www (работает после выпуска SSL-сертификата) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# ---- Типы файлов ----
AddType application/manifest+json .webmanifest
AddType application/json .json
AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/x-icon .ico
AddType text/javascript .js

# ---- Сжатие ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>

# ---- Кеширование ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # service worker и конфиг аналитики всегда берутся свежими — иначе обновления сайта не дойдут до телефонов
  <FilesMatch "^(sw\.js|manifest\.json|analytics-config\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---- Закрыть служебные файлы ----
<FilesMatch "^(\.git.*|\.nojekyll|.*\.md|.*\.py|.*\.sh)$">
  Require all denied
</FilesMatch>
