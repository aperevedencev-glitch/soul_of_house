# Токен бота от @BotFather (никому не показывайте)
BOT_TOKEN=
# ID чата мастера, куда приходят заявки и вопросы. Узнать: напишите боту /myid
ADMIN_CHAT_ID=
# Ссылка на сайт (кнопка «Сайт» и «Смотреть фото на сайте»)
SITE_URL=https://claude.ai/artifact/L9tkb9o4usK4XPrydG7Tme

# ===== ИИ для Нейрокота (необязательно; без ключа — ответы по базе вопросов) =====
# Вариант 1 (по умолчанию) — бесплатная модель Qwen3.8 27B через OpenRouter.
# Ключ: openrouter.ai → Keys → Create key. Лимиты бесплатных моделей: ~20 запросов/мин и ~200/день.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen3.8-27b:free

# Вариант 2 — DeepSeek (платно, очень дёшево; platform.deepseek.com → API keys):
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash

# Вариант 3 — Claude (Anthropic). Используется, только если AI_API_KEY пуст:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
